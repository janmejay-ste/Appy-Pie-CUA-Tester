# ============================================================
# AppyPie CUA Tester — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── OpenAI ──────────────────────────────────────────────────
# Required. API key for GPT-5.4 (used by the CUA loop).
OPENAI_API_KEY=sk-...

# ── Turso (Database) ────────────────────────────────────────
# Turso database URL. Use "file:local.db" for local SQLite,
# or "libsql://your-db-name-org.turso.io" for Turso cloud.
TURSO_DATABASE_URL=libsql://cua-automate-thejanmejay.aws-ap-south-1.turso.io
# Auth token for Turso cloud. Not needed for local file DB.
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3NzU2NDcwNzUsImlkIjoiMDE5ZDZjY2YtODUwMS03MjM1LTg0OTgtYzVjZDI5MjkzOTkwIiwicmlkIjoiZjBjOWE3MmQtMzlmNS00NTgzLWI3ZWItZjdkMmRjYzI3NmQyIn0.U17OmAY5ZpoWH0rqT4wvdOrCg1TkwHgZ9ITxVt1I3PQmHzNgutcTw7o7MosuywfNm_5RM01Kyilp7VSMIw9_AA

# ── Redis ───────────────────────────────────────────────────
# Redis URL used by BullMQ job queue and SSE pub/sub.
REDIS_URL=redis://127.0.0.1:6379

# ── Runner (Express API) ───────────────────────────────────
# Port for the runner API server.
RUNNER_PORT=3001
# Set to "production" to enforce INTERNAL_API_KEY and other guards.
NODE_ENV=development

# ── Dashboard ───────────────────────────────────────────────
# Public URL the Next.js dashboard uses to reach the runner API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Security ────────────────────────────────────────────────
# Optional API key to protect runner endpoints. If not set,
# auth is skipped in development. Must be set in production.
INTERNAL_API_KEY=
# Comma-separated origins allowed to call the runner API via CORS.
DASHBOARD_URL=http://localhost:3002
# Comma-separated domains the CUA browser is allowed to navigate to.
ALLOWED_DOMAINS=appypieautomate.ai,connectcloud.appypie.com,appypie.com

# ── Test Account ────────────────────────────────────────────
# Default credentials for tests that require authentication.
# Can also be updated at runtime from the dashboard Settings tab.
DEFAULT_TEST_EMAIL=
DEFAULT_TEST_PASSWORD=

# ── Logging ─────────────────────────────────────────────────
# Log level: trace, debug, info, warn, error, fatal. Default: info.
LOG_LEVEL=info

# ── Cleanup & Retention ────────────────────────────────────
# How many days to keep completed test runs before cleanup.
RETENTION_DAYS=7
# Max number of failed runs to keep globally (for debugging).
KEEP_FAILED_RUNS=50

# ── Alert Thresholds ───────────────────────────────────────
# Failure rate % (24h) to trigger alert. Default: 30.
ALERT_FAILURE_RATE=30
# Queue backlog size to trigger alert. Default: 20.
ALERT_QUEUE_SIZE=20
# Avg test latency (ms) to trigger alert. Default: 300000 (5 min).
ALERT_AVG_LATENCY_MS=300000
